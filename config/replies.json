{
  "enabled": true,
  "fallback": "",
  "rules": [
    {
      "id": "presence",
      "type": "exact",
      "match": ["在吗", "在不在", "在么"],
      "reply": "在。本鲸在值班，有事直接说。"
    },
    {
      "id": "help",
      "type": "exact",
      "match": ["/help", "帮助"],
      "reply": "可用：/status 看状态、/help 看命令；其它消息我会看情况回。"
    },
    {
      "id": "status",
      "type": "exact",
      "match": ["/status", "状态"],
      "action": "status"
    },
    {
      "id": "llm",
      "type": "contains",
      "match": ["帮我", "报错", "失败", "bug", "怎么", "为什么"],
      "action": "llm"
    },
    {
      "id": "ignore",
      "type": "contains",
      "match": ["抽奖", "互关", "广告", "点赞"],
      "action": "ignore"
    }
  ]
}
